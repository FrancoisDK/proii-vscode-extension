{
  "comments": {
    "lineComment": "$"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(UNIT OPERATIONS|COMPONENT DATA|STREAM DATA|THERMODYNAMIC DATA|PROCEDURE|CALCULATOR)",
      "end": "^\\s*END"
    }
  }
}
