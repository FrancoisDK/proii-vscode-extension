{
  "name": "proii-language-support",
  "displayName": "PRO/II Language Support",
  "description": "Syntax highlighting, hover tooltips, and language support for PRO/II input and output files (.inp, .std, .out)",
  "version": "1.4.5",
  "publisher": "francois-de-klerk",
  "icon": "PRO_II.png",
  "author": "Francois de Klerk",
  "activationEvents": [
    "onLanguage:proii"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancoisDK/proii-vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "proii",
    "pro/ii",
    "chemical engineering",
    "process simulation",
    "inp",
    "std",
    "out"
  ],
  "contributes": {
    "commands": [
      {
        "command": "proii.refreshSemanticTokens",
        "title": "Refresh Stream Name Highlighting",
        "category": "PRO/II"
      }
    ],
    "languages": [
      {
        "id": "proii",
        "aliases": [
          "PRO/II",
          "proii"
        ],
        "extensions": [
          ".inp",
          ".std",
          ".out"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "proii",
        "scopeName": "source.proii",
        "path": "./syntaxes/proii.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "proii",
        "path": "./snippets/proii-snippets.json"
      }
    ],
    "configuration": {
      "title": "PRO/II Stream Names",
      "properties": {
        "proii.streamNames.enabledLengths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "default": [3, 4, 5, 6],
          "description": "Stream name lengths to highlight (e.g., [3, 4, 5, 6] for 3-6 character names)",
          "scope": "resource"
        },
        "proii.streamNames.minLength": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Minimum stream name length to highlight",
          "scope": "resource"
        },
        "proii.streamNames.maxLength": {
          "type": "integer",
          "default": 6,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum stream name length to highlight",
          "scope": "resource"
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "streamName",
        "description": "Stream name from NAME section (dynamically parsed)"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "streamReference",
        "description": "Reference to a defined stream"
      }
    ],
    "semanticTokenColors": {
      "streamName": {
        "dark": "#569CD6",
        "light": "#0000FF", 
        "highContrast": "#569CD6",
        "fontStyle": ""
      }
    },
    "configurationDefaults": {
      "editor.semanticHighlighting.enabled": true,
      "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
          "streamName": {
            "foreground": "#569CD6",
            "fontStyle": ""
          }
        }
      },
      "[Default Dark Modern]": {
        "editor.tokenColorCustomizations": {
          "textMateRules": [
            {
              "scope": "string.unquoted.result-description.proii",
              "settings": {
                "foreground": "#4EC9B0"
              }
            },
            {
              "scope": "entity.name.type.unit.proii",
              "settings": {
                "fontStyle": ""
              }
            }
            ,
            {
              "scope": "constant.character.escape.continuation.proii",
              "settings": {
                "foreground": "#FFD700",
                "fontStyle": ""
              }
            }
          ]
        }
      }
    }
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/francois-deklerk/proii-vscode-extension/issues"
  },
  "homepage": "https://github.com/francois-deklerk/proii-vscode-extension#readme",
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/vscode": "^1.105.0",
    "typescript": "^5.9.3"
  }
}
