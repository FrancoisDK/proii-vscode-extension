{
  "name": "proii-language-support",
  "displayName": "PRO/II Language Support",
  "description": "Syntax highlighting, hover tooltips, and language support for PRO/II input and output files (.inp, .std, .out)",
  "version": "1.3.0",
  "publisher": "Francois de Klerk",
  "icon": "PRO_II.png",
  "author": "Francois de Klerk",
  "activationEvents": [
    "onLanguage:proii"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancoisDK/proii-vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "proii",
    "pro/ii",
    "chemical engineering",
    "process simulation",
    "inp",
    "std",
    "out"
  ],
  "contributes": {
    "languages": [
      {
        "id": "proii",
        "aliases": [
          "PRO/II",
          "proii"
        ],
        "extensions": [
          ".inp",
          ".std",
          ".out"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "proii",
        "scopeName": "source.proii",
        "path": "./syntaxes/proii.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "proii",
        "path": "./snippets/proii-snippets.json"
      }
    ]
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/francois-deklerk/proii-vscode-extension/issues"
  },
  "homepage": "https://github.com/francois-deklerk/proii-vscode-extension#readme",
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/vscode": "^1.105.0",
    "typescript": "^5.9.3"
  }
}
